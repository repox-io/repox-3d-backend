          <MetadataElement name="rdf:resource" type="String" readonly="True" />
          <MetadataElement name="edm:type" type="URI" readonly="True" />
          <MetadataElement name="edm:aggregatedCHO" type="String" readonly="True" />
          <MetadataElement name="edm:dataProvider" type="String" readonly="True" />
          <MetadataElement name="edm:provider" type="String" readonly="True" />
          <MetadataElement name="edm:rights" type="URI" readonly="True" />
          <MetadataElement name="dc:language" type="URI" readonly="True" />
          <MetadataElement name="dc:subject" type="String" readonly="True" />

          <!-- Conditional (at least one out of two is required for each group)-->
          <MetadataElement name="dcterms:spatial" type="String" readonly="True" />
          <MetadataElement name="dcterms:temporal" type="Date" readonly="True" />

          <MetadataElement name="dc:title" type="String" readonly="True" />
          <MetadataElement name="dc:description" type="String" readonly="True" />

          <MetadataElement name="edm:isShownAt" type="URI" readonly="True" />
          <MetadataElement name="edm:isShownBy" type="URI" readonly="True" />

          <!-- Non Mandatory -->
          <!-- identity -->
          <MetadataElement name="dc:identifier" type="String" readonly="True" />
          <MetadataElement name="dc:creator" type="String" readonly="True" />
          <MetadataElement name="dcterms:created" type="date" readonly="True" />
          <MetadataElement name="dc:contributor" type="String" readonly="True" />
          <MetadataElement name="dc:publisher" type="String" readonly="True" />

          <!-- Creation Context -->
          <MetadataElement name="creationProcess" type="String" readonly="True" />
          <MetadataElement name="creationDescription" type="String" readonly="True" />
          <MetadataElement name="dc:provenance" type="String" readonly="True" />

          <!-- Relationships -->
          <MetadataElement name="dc:source" type="URI" readonly="True" />
          <MetadataElement name="dc:relation" type="URI" readonly="True" />
          <MetadataElement name="dcterms:isPartOf" type="URI" readonly="True" />
          <MetadataElement name="dcterms:hasPart" type="URI" readonly="True" />
          <MetadataElement name="dcterms:isFormatOf" type="URI" readonly="True" />
          <MetadataElement name="dcterms:isReferencedBy" type="URI" readonly="True" />
          <MetadataElement name="dcterms:isReplacedBy" type="URI" readonly="True" />
          <MetadataElement name="dcterms:isRequiredBy" type="URI" readonly="True" />
          <MetadataElement name="dcterms:isVersionOf" type="URI" readonly="True" />
          <MetadataElement name="dcterms:replaces" type="String" readonly="True" />
          <MetadataElement name="dcterms:requires" type="String" readonly="True" />
          <MetadataElement name="dcterms:hasPart" type="URI" readonly="True" />
          <MetadataElement name="dcterms:hasVersion" type="String" readonly="True" />
          <MetadataElement name="edm:isRelatedTo" type="URI" readonly="True" />
          <MetadataElement name="edm:isRepresentationOf" type="URI" readonly="True" />
          <MetadataElement name="edm:isSimilarTo" type="URI" readonly="True" />
          <MetadataElement name="edm:isSuccessorOf" type="URI" readonly="True" />
          <MetadataElement name="edm:incorporates" type="String" readonly="True" />
          <MetadataElement name="edm:isDerivativeOf" type="String" readonly="True" />
          <MetadataElement name="edm:IsNextInSequence" type="Integer" readonly="True" />

          <!-- Media / Format -->
          <MetadataElement name="dc:format" type="URI" readonly="True" />
          <MetadataElement name="dcterms:hasFormat" type="String" readonly="True" />
          <MetadataElement name="edm:hasType" type="String" readonly="True" />
          <MetadataElement name="isDownloadable" type="Boolean" readonly="True" />
          <MetadataElement name="dc:accessRights" type="String" readonly="True" />

          <!-- Location / Time -->
          <MetadataElement name="dc:date" type="Date" readonly="True" />
          <MetadataElement name="edm:currentLocation" type="String" readonly="True" />
          <MetadataElement name="periods" type="String" readonly="True" />

